{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/titles-captions-plan.schema.json",
  "title": "Source- and edit-bound titles and captions plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "unit_id", "source_context", "items", "hierarchy_and_rhythm", "credits_scope", "assumptions", "uncertainties"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "nullableId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "segment": {"type": "object", "additionalProperties": false, "required": ["segment_id", "source_reference"], "properties": {"segment_id": {"$ref": "#/$defs/id"}, "source_reference": {"$ref": "#/$defs/text"}}},
    "editVersion": {"type": "object", "additionalProperties": false, "required": ["edit_version_id", "status", "lock_decision_id", "segment_ids", "source_reference"], "properties": {"edit_version_id": {"$ref": "#/$defs/id"}, "status": {"const": "locked"}, "lock_decision_id": {"$ref": "#/$defs/id"}, "segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "source_reference": {"$ref": "#/$defs/text"}}},
    "textSource": {"type": "object", "additionalProperties": false, "required": ["text_source_id", "kind", "text", "source_reference"], "properties": {"text_source_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["supplied-dialogue", "supplied-title", "supplied-credit", "supplied-translation", "editorial-proposal"]}, "text": {"$ref": "#/$defs/text"}, "source_reference": {"$ref": "#/$defs/text"}}},
    "timebase": {"type": "object", "additionalProperties": false, "required": ["frames_per_second", "drop_frame"], "properties": {"frames_per_second": {"type": "string", "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"}, "drop_frame": {"type": "boolean"}}},
    "timingRecord": {"type": "object", "additionalProperties": false, "required": ["timing_record_id", "item_id", "segment_id", "edit_version_id", "coordinate_space", "timebase", "start_frame", "end_frame", "start_timecode", "end_timecode", "source_reference"], "properties": {"timing_record_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/id"}, "segment_id": {"$ref": "#/$defs/id"}, "edit_version_id": {"$ref": "#/$defs/id"}, "coordinate_space": {"enum": ["output-timeline", "source-media"]}, "timebase": {"$ref": "#/$defs/timebase"}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 1}, "start_timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9][=:;][0-9]{2}$"}, "end_timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9][=:;][0-9]{2}$"}, "source_reference": {"$ref": "#/$defs/text"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_type", "claim", "item_id", "segment_id", "edit_version_id", "revision", "content", "language", "speaker_identification", "sound_description", "placement_region", "timing_record_id", "decision_value", "source_reference", "content_kind", "text_state", "text_source"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "evidence_type": {"enum": ["review", "human-approval"]}, "claim": {"enum": ["current-item-review", "approval"]}, "item_id": {"$ref": "#/$defs/id"}, "segment_id": {"$ref": "#/$defs/id"}, "edit_version_id": {"$ref": "#/$defs/id"}, "revision": {"type": "string", "pattern": "^r[0-9]{3,}$"}, "content": {"$ref": "#/$defs/text"}, "language": {"$ref": "#/$defs/nullableText"}, "speaker_identification": {"$ref": "#/$defs/annotation"}, "sound_description": {"$ref": "#/$defs/annotation"}, "placement_region": {"$ref": "#/$defs/text"}, "timing_record_id": {"$ref": "#/$defs/id"}, "decision_value": {"$ref": "#/$defs/text"}, "source_reference": {"$ref": "#/$defs/text"}, "content_kind": {"$ref": "#/$defs/contentState/properties/content_kind"}, "text_state": {"$ref": "#/$defs/contentState/properties/state"}, "text_source": {"anyOf": [{"$ref": "#/$defs/textSource"}, {"type": "null"}]}}},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "contentState": {"type": "object", "additionalProperties": false, "required": ["content", "content_kind", "state", "text_source_id"], "properties": {"content": {"$ref": "#/$defs/text"}, "content_kind": {"enum": ["dialogue", "nonspeech", "title", "credit"]}, "state": {"enum": ["supplied", "proposed"]}, "text_source_id": {"$ref": "#/$defs/nullableId"}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["region", "safe_area_state", "exception_rationale"], "properties": {"region": {"$ref": "#/$defs/text"}, "safe_area_state": {"enum": ["unknown", "proposed", "specification-backed", "exception"]}, "exception_rationale": {"$ref": "#/$defs/nullableText"}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["mode", "intent", "timing_record_id"], "properties": {"mode": {"enum": ["creative-intent", "exact-supplied"]}, "intent": {"$ref": "#/$defs/text"}, "timing_record_id": {"$ref": "#/$defs/nullableId"}}},
    "readability": {"type": "object", "additionalProperties": false, "required": ["contrast_strategy", "line_break_intent", "reading_speed_target", "line_length_target", "specification_reference"], "properties": {"contrast_strategy": {"$ref": "#/$defs/text"}, "line_break_intent": {"$ref": "#/$defs/text"}, "reading_speed_target": {"$ref": "#/$defs/nullableText"}, "line_length_target": {"$ref": "#/$defs/nullableText"}, "specification_reference": {"$ref": "#/$defs/nullableText"}}},
    "annotation": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["not-applicable", "not-required", "proposed", "supplied"]}, "value": {"$ref": "#/$defs/nullableText"}}},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["mode", "assumption"], "properties": {"mode": {"enum": ["burn-in", "sidecar", "either"]}, "assumption": {"$ref": "#/$defs/text"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["state", "evidence_ids"], "properties": {"state": {"enum": ["not-requested", "pending", "changes-requested", "approved"]}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["item_id", "type", "edit_segment_id", "text", "placement", "timing", "typography_intent", "readability", "language", "speaker_identification", "sound_description", "presentation", "revision", "approval"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["main-title", "intertitle", "lower-third", "credit", "subtitle", "accessibility-caption"]}, "edit_segment_id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/contentState"}, "placement": {"$ref": "#/$defs/placement"}, "timing": {"$ref": "#/$defs/timing"}, "typography_intent": {"$ref": "#/$defs/text"}, "readability": {"$ref": "#/$defs/readability"}, "language": {"$ref": "#/$defs/nullableText"}, "speaker_identification": {"$ref": "#/$defs/annotation"}, "sound_description": {"$ref": "#/$defs/annotation"}, "presentation": {"$ref": "#/$defs/presentation"}, "revision": {"type": "string", "pattern": "^r[0-9]{3,}$"}, "approval": {"$ref": "#/$defs/approval"}}}
  },
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {"$ref": "#/$defs/id"},
    "unit_id": {"$ref": "#/$defs/id"},
    "source_context": {"type": "object", "additionalProperties": false, "required": ["edit_segments", "edit_versions", "text_sources", "timing_records", "evidence"], "properties": {"edit_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}, "edit_versions": {"type": "array", "items": {"$ref": "#/$defs/editVersion"}}, "text_sources": {"type": "array", "items": {"$ref": "#/$defs/textSource"}}, "timing_records": {"type": "array", "items": {"$ref": "#/$defs/timingRecord"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "hierarchy_and_rhythm": {"$ref": "#/$defs/text"},
    "credits_scope": {"type": "object", "additionalProperties": false, "required": ["state", "entries", "clearance_note"], "properties": {"state": {"enum": ["unresolved", "supplied", "reviewed"]}, "entries": {"$ref": "#/$defs/strings"}, "clearance_note": {"$ref": "#/$defs/text"}}},
    "assumptions": {"$ref": "#/$defs/strings"},
    "uncertainties": {"$ref": "#/$defs/strings"}
  }
}
