{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/character-look-bible.schema.json",
  "title": "Character Look Bible",
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "character_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "anchor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-AN(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "state_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-ST(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-RF(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "drift_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-DR(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "source_reference"],
      "properties": {
        "status": {"enum": ["supplied", "inferred", "proposed"]},
        "basis": {"$ref": "#/$defs/non_empty_string"},
        "source_reference": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "supplied_provenance": {
      "allOf": [
        {"$ref": "#/$defs/provenance"},
        {"properties": {"status": {"const": "supplied"}}}
      ]
    },
    "proposed_provenance": {
      "allOf": [
        {"$ref": "#/$defs/provenance"},
        {"properties": {"status": {"const": "proposed"}}}
      ]
    },
    "appearance_claim": {
      "description": "A consequential appearance claim. When provenance.status is supplied, its exact value and provenance.source_reference pair must be declared for the same character in source_context.identity_statements.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "supplied_claim": {
      "description": "A supplied claim whose exact value and provenance.source_reference pair is source-declared for its character.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/supplied_provenance"}
      }
    },
    "proposed_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/proposed_provenance"}
      }
    },
    "shot_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "shot_id"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "identity_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "claim"],
      "properties": {
        "character_id": {"$ref": "#/$defs/character_id"},
        "claim": {"$ref": "#/$defs/supplied_claim"}
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_ids", "scene_ids", "shots", "identity_statements"],
      "properties": {
        "character_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/character_id"},
          "uniqueItems": true
        },
        "scene_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shot_record"},
          "uniqueItems": true
        },
        "identity_statements": {
          "description": "The per-character source ledger. Each entry declares one exact supplied value and source_reference pair; downstream supplied appearance claims must match a pair owned by the same character.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identity_statement"},
          "uniqueItems": true
        }
      }
    },
    "immutable_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "aspect", "claim"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/anchor_id"},
        "aspect": {"$ref": "#/$defs/non_empty_string"},
        "claim": {"$ref": "#/$defs/appearance_claim"}
      }
    },
    "applicable_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "details"],
      "properties": {
        "applicability": {"enum": ["specified", "not-applicable"]},
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        }
      }
    },
    "prohibited_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drift_id", "anchor_ids", "claim"],
      "properties": {
        "drift_id": {"$ref": "#/$defs/drift_id"},
        "anchor_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/anchor_id"},
          "uniqueItems": true
        },
        "claim": {"$ref": "#/$defs/appearance_claim"}
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_id", "name", "supplied_identity", "visual_treatment",
        "immutable_anchors", "permitted_variations", "proportions",
        "face_body_descriptors", "silhouette", "palette", "hair_makeup",
        "expression_range", "pose_range", "prohibited_drift"
      ],
      "properties": {
        "character_id": {"$ref": "#/$defs/character_id"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "supplied_identity": {"$ref": "#/$defs/supplied_claim"},
        "visual_treatment": {"$ref": "#/$defs/proposed_claim"},
        "immutable_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/immutable_anchor"}
        },
        "permitted_variations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "proportions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "face_body_descriptors": {"$ref": "#/$defs/applicable_claims"},
        "silhouette": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "hair_makeup": {"$ref": "#/$defs/applicable_claims"},
        "expression_range": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "pose_range": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/appearance_claim"}
        },
        "prohibited_drift": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/prohibited_drift"}
        }
      }
    },
    "anchor_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "effect"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/anchor_id"},
        "effect": {"enum": ["preserve", "vary", "contradict"]}
      }
    },
    "continuity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id", "character_id", "order", "previous_state_id", "scene_id",
        "shot_ids", "anchor_effects", "wardrobe", "hair_makeup",
        "material_surface", "change"
      ],
      "properties": {
        "state_id": {"$ref": "#/$defs/state_id"},
        "character_id": {"$ref": "#/$defs/character_id"},
        "order": {"type": "integer", "minimum": 1},
        "previous_state_id": {
          "oneOf": [{"$ref": "#/$defs/state_id"}, {"type": "null"}]
        },
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "anchor_effects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/anchor_effect"}
        },
        "wardrobe": {"$ref": "#/$defs/appearance_claim"},
        "hair_makeup": {"$ref": "#/$defs/appearance_claim"},
        "material_surface": {"$ref": "#/$defs/appearance_claim"},
        "change": {"$ref": "#/$defs/appearance_claim"}
      }
    },
    "reference_need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "character_id", "state_ids", "view", "purpose"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/reference_id"},
        "character_id": {"$ref": "#/$defs/character_id"},
        "state_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/state_id"},
          "uniqueItems": true
        },
        "view": {
          "enum": [
            "front-turnaround", "profile-left", "profile-right", "back-turnaround",
            "three-quarter", "detail", "expression-sheet", "pose-sheet",
            "wardrobe-state", "material-state", "other"
          ]
        },
        "purpose": {"$ref": "#/$defs/appearance_claim"}
      }
    },
    "shot_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "shot_id", "character_id", "state_id", "reference_ids"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_id": {"$ref": "#/$defs/non_empty_string"},
        "character_id": {"$ref": "#/$defs/character_id"},
        "state_id": {"$ref": "#/$defs/state_id"},
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference_id"},
          "uniqueItems": true
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "source_context", "characters",
    "continuity_states", "reference_needs", "shot_coverage", "assumptions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "source_context": {"$ref": "#/$defs/source_context"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/character"}
    },
    "continuity_states": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/continuity_state"}
    },
    "reference_needs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference_need"}
    },
    "shot_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot_coverage"}
    },
    "assumptions": {"$ref": "#/$defs/string_array"},
    "uncertainties": {"$ref": "#/$defs/string_array"}
  }
}
