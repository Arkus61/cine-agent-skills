{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/vfx-post-plan.schema.json",
  "title": "Evidence-aware VFX post plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "unit_id", "source_context", "items", "dependencies", "assumptions", "uncertainties"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "nullableId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["source_reference"],
      "properties": {"source_reference": {"$ref": "#/$defs/text"}}
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "source_reference"],
      "properties": {"effect_id": {"$ref": "#/$defs/id"}, "source_reference": {"$ref": "#/$defs/text"}}
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "source_reference"],
      "properties": {"segment_id": {"$ref": "#/$defs/id"}, "source_reference": {"$ref": "#/$defs/text"}}
    },
    "mediaVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["media_id", "version_id", "roles", "source_reference"],
      "properties": {
        "media_id": {"$ref": "#/$defs/id"},
        "version_id": {"$ref": "#/$defs/id"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["source", "plate", "output"]}},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "item_id", "version_id", "source_reference"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "evidence_type": {"enum": ["inspection", "technical-qc", "human-approval", "delivery-verification"]},
        "item_id": {"$ref": "#/$defs/id"},
        "version_id": {"$ref": "#/$defs/id"},
        "source_reference": {"$ref": "#/$defs/text"},
        "target_id": {"$ref": "#/$defs/id"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "specification", "source_reference"],
      "properties": {"target_id": {"$ref": "#/$defs/id"}, "specification": {"$ref": "#/$defs/text"}, "source_reference": {"$ref": "#/$defs/text"}}
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "target_id", "evidence_ids"],
      "properties": {
        "status": {"enum": ["not-planned", "planned", "candidate", "verified"]},
        "target_id": {"$ref": "#/$defs/nullableId"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "preproduction_effect_ids", "edit_segment_ids", "purpose", "source_version_ids", "current_output_version_id", "workstreams", "dependency_ids", "review_status", "review_evidence_ids", "delivery", "handoff_assumptions"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "preproduction_effect_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "edit_segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "purpose": {"$ref": "#/$defs/text"},
        "source_version_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "current_output_version_id": {"$ref": "#/$defs/nullableId"},
        "workstreams": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "applicability", "action", "assumption"], "properties": {"type": {"enum": ["plate", "tracking", "rotoscoping", "keying", "cleanup", "compositing", "simulation", "lens-integration", "defocus-integration", "grain-integration", "color-handoff", "final-verification"]}, "applicability": {"enum": ["not-applicable", "awaiting-input", "planned", "in-progress", "complete"]}, "action": {"$ref": "#/$defs/text"}, "assumption": {"$ref": "#/$defs/text"}}}},
        "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "review_status": {"enum": ["planned", "awaiting-media", "candidate", "changes-requested", "approved"]},
        "review_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "delivery": {"$ref": "#/$defs/delivery"},
        "handoff_assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["dependency_id", "upstream_item_id", "downstream_item_id", "order", "purpose"],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/id"}, "upstream_item_id": {"$ref": "#/$defs/id"}, "downstream_item_id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1}, "purpose": {"$ref": "#/$defs/text"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {"$ref": "#/$defs/id"},
    "unit_id": {"$ref": "#/$defs/id"},
    "source_context": {
      "type": "object", "additionalProperties": false,
      "required": ["preproduction_effects", "edit_segments", "media_versions", "evidence", "delivery_targets"],
      "properties": {
        "preproduction_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "edit_segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "media_versions": {"type": "array", "items": {"$ref": "#/$defs/mediaVersion"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "delivery_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  }
}
