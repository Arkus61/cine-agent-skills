{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/edit-plan.schema.json",
  "title": "Evidence-aware film edit plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "unit_id",
    "project_format",
    "source_context",
    "editorial_strategy",
    "segments",
    "assumptions",
    "uncertainties"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:U|E)(?:0[1-9]|[1-9][0-9])$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:U|E)(?:0[1-9]|[1-9][0-9])-(?:S(?:0[1-9]|[1-9][0-9])|SC(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:U|E)(?:0[1-9]|[1-9][0-9])-(?:S(?:0[1-9]|[1-9][0-9])|SC(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))-SH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "media_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-MD(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "timing_evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-TM(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "lock_decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-LK(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "segment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:U|E)(?:0[1-9]|[1-9][0-9])-ED(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "timecode": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]:[0-9]{2,3}$"
    },
    "shot_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "scene_id", "source_reference"],
      "properties": {
        "shot_id": {"$ref": "#/$defs/shot_id"},
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "media_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "shot_id", "review_status", "source_reference"],
      "properties": {
        "media_id": {"$ref": "#/$defs/media_id"},
        "shot_id": {"$ref": "#/$defs/shot_id"},
        "review_status": {
          "enum": ["approved", "repair", "regenerate", "human-review"]
        },
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "timing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_evidence_id",
        "media_id",
        "exact_source_in",
        "exact_source_out",
        "source_reference"
      ],
      "properties": {
        "timing_evidence_id": {"$ref": "#/$defs/timing_evidence_id"},
        "media_id": {"$ref": "#/$defs/media_id"},
        "exact_source_in": {"$ref": "#/$defs/timecode"},
        "exact_source_out": {"$ref": "#/$defs/timecode"},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "lock_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_decision_id",
        "segment_id",
        "source_media_ids",
        "decision",
        "current",
        "source_reference"
      ],
      "properties": {
        "lock_decision_id": {"$ref": "#/$defs/lock_decision_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "source_media_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/media_id"}
        },
        "decision": {"const": "picture-locked"},
        "current": {"const": true},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "in_out_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit"],
      "properties": {
        "entry": {"$ref": "#/$defs/text"},
        "exit": {"$ref": "#/$defs/text"},
        "exact_source_in": {"$ref": "#/$defs/timecode"},
        "exact_source_out": {"$ref": "#/$defs/timecode"}
      },
      "dependentRequired": {
        "exact_source_in": ["exact_source_out"],
        "exact_source_out": ["exact_source_in"]
      }
    },
    "cut_motivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "rationale"],
      "properties": {
        "dimension": {
          "enum": [
            "emotion",
            "story",
            "rhythm",
            "eye-trace",
            "screen-plane",
            "movement",
            "sound"
          ]
        },
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent"],
      "properties": {
        "type": {
          "enum": [
            "cut",
            "match-cut",
            "jump-cut",
            "cutaway",
            "reaction-cut",
            "j-cut",
            "l-cut",
            "sound-bridge",
            "parallel-cut",
            "cross-cut",
            "dissolve",
            "fade"
          ]
        },
        "intent": {"$ref": "#/$defs/text"}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "intent"],
      "properties": {
        "mode": {
          "enum": [
            "continuity",
            "intentional-discontinuity",
            "associative-montage",
            "parallel-continuity"
          ]
        },
        "intent": {"$ref": "#/$defs/text"}
      }
    },
    "sound_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent"],
      "properties": {
        "type": {"enum": ["none", "j-cut", "l-cut", "sound-bridge"]},
        "intent": {"$ref": "#/$defs/text"}
      }
    },
    "temporal_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "intent"],
      "properties": {
        "mode": {
          "enum": [
            "real-time",
            "ellipsis",
            "compression",
            "expansion",
            "parallel-time",
            "associative"
          ]
        },
        "intent": {"$ref": "#/$defs/text"}
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "source_shot_ids",
        "source_media_ids",
        "edit_intent"
      ],
      "properties": {
        "condition": {"$ref": "#/$defs/text"},
        "source_shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shot_id"}
        },
        "source_media_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/media_id"}
        },
        "edit_intent": {"$ref": "#/$defs/text"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "assembly_order",
        "source_shot_ids",
        "source_media_ids",
        "dramatic_purpose",
        "in_out_intent",
        "cut_motivation",
        "transition",
        "eye_trace",
        "motion",
        "continuity",
        "rhythm",
        "dialogue_sound_bridge",
        "temporal_treatment",
        "alternatives",
        "evidence_status",
        "lock_status"
      ],
      "properties": {
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "assembly_order": {"type": "integer", "minimum": 1},
        "source_shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shot_id"}
        },
        "source_media_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/media_id"}
        },
        "dramatic_purpose": {"$ref": "#/$defs/text"},
        "in_out_intent": {"$ref": "#/$defs/in_out_intent"},
        "cut_motivation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cut_motivation"}
        },
        "transition": {"$ref": "#/$defs/transition"},
        "eye_trace": {"$ref": "#/$defs/text"},
        "motion": {"$ref": "#/$defs/text"},
        "continuity": {"$ref": "#/$defs/continuity"},
        "rhythm": {"$ref": "#/$defs/text"},
        "dialogue_sound_bridge": {"$ref": "#/$defs/sound_bridge"},
        "temporal_treatment": {"$ref": "#/$defs/temporal_treatment"},
        "alternatives": {
          "type": "array",
          "items": {"$ref": "#/$defs/alternative"}
        },
        "evidence_status": {"enum": ["planned", "inspected"]},
        "lock_status": {
          "enum": ["unlocked", "rough-cut", "fine-cut", "picture-locked"]
        },
        "timing_evidence_id": {"$ref": "#/$defs/timing_evidence_id"},
        "lock_decision_id": {"$ref": "#/$defs/lock_decision_id"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "unit_id": {"$ref": "#/$defs/unit_id"},
    "project_format": {
      "enum": [
        "feature",
        "short",
        "series",
        "documentary",
        "commercial",
        "music-video",
        "short-form"
      ]
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenplay_metadata_reference",
        "production_plan_references",
        "shots",
        "media_items",
        "timing_evidence",
        "lock_decisions"
      ],
      "properties": {
        "screenplay_metadata_reference": {"$ref": "#/$defs/text"},
        "production_plan_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shot_source"}
        },
        "media_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/media_source"}
        },
        "timing_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/timing_evidence"}
        },
        "lock_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/lock_decision"}
        }
      }
    },
    "editorial_strategy": {"$ref": "#/$defs/text"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    }
  }
}
