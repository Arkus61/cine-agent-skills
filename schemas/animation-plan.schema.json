{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/animation-plan.schema.json",
  "title": "Animation Plan",
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "character_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CH(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "camera_intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-CI(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "performance_intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-PI(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "animation_plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "acting_beat_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-AB(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "key_pose_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-KP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "hold_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-HD(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "simulation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-SM(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "continuity_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-CT(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "source_reference"],
      "properties": {
        "status": {"enum": ["supplied", "inferred", "proposed", "approved"]},
        "basis": {"$ref": "#/$defs/non_empty_string"},
        "source_reference": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "supplied_provenance": {
      "allOf": [
        {"$ref": "#/$defs/provenance"},
        {"properties": {"status": {"const": "supplied"}}}
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "purpose", "provenance"],
      "properties": {
        "value": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "camera_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "value", "provenance"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/camera_intent_id"},
        "value": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/supplied_provenance"}
      }
    },
    "performance_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "character_id", "value", "provenance"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/performance_intent_id"},
        "character_id": {"$ref": "#/$defs/character_id"},
        "value": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/supplied_provenance"}
      }
    },
    "supplied_fact": {
      "type": "object",
      "description": "An exact supplied value/reference pair scoped to this shot or to one supplied character in this shot.",
      "additionalProperties": false,
      "required": ["scope", "character_id", "value", "source_reference"],
      "properties": {
        "scope": {"enum": ["shot", "shot-character"]},
        "character_id": {
          "oneOf": [
            {"$ref": "#/$defs/character_id"},
            {"type": "null"}
          ]
        },
        "value": {"$ref": "#/$defs/non_empty_string"},
        "source_reference": {"$ref": "#/$defs/non_empty_string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"scope": {"const": "shot"}},
            "required": ["scope"]
          },
          "then": {"properties": {"character_id": {"type": "null"}}},
          "else": {
            "properties": {
              "character_id": {"$ref": "#/$defs/character_id"}
            }
          }
        }
      ]
    },
    "timing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "frames_per_second", "range_end"],
      "properties": {
        "unit": {"enum": ["frames", "seconds", "milliseconds"]},
        "frames_per_second": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "range_end": {"const": "exclusive"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"unit": {"const": "frames"}},
            "required": ["unit"]
          },
          "then": {
            "properties": {
              "frames_per_second": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "source_shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id", "shot_id", "duration", "character_ids",
        "camera_intent", "performance_intents", "supplied_facts"
      ],
      "properties": {
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_id": {"$ref": "#/$defs/non_empty_string"},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "character_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/character_id"},
          "uniqueItems": true
        },
        "camera_intent": {"$ref": "#/$defs/camera_intent"},
        "performance_intents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/performance_intent"},
          "uniqueItems": true
        },
        "supplied_facts": {
          "type": "array",
          "description": "The authoritative inventory for downstream claims marked supplied; exact duplicate records are forbidden.",
          "items": {"$ref": "#/$defs/supplied_fact"},
          "uniqueItems": true
        }
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_ids", "scene_ids", "timing", "shots"],
      "properties": {
        "character_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/character_id"},
          "uniqueItems": true
        },
        "scene_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "timing": {"$ref": "#/$defs/timing_context"},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_shot"},
          "uniqueItems": true
        }
      }
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      }
    },
    "acting_beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acting_beat_id", "timing", "action", "performance",
        "purpose", "provenance"
      ],
      "properties": {
        "acting_beat_id": {"$ref": "#/$defs/acting_beat_id"},
        "timing": {"$ref": "#/$defs/time_range"},
        "action": {"$ref": "#/$defs/non_empty_string"},
        "performance": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "key_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_pose_id", "acting_beat_id", "at", "pose",
        "readability", "purpose", "provenance"
      ],
      "properties": {
        "key_pose_id": {"$ref": "#/$defs/key_pose_id"},
        "acting_beat_id": {"$ref": "#/$defs/acting_beat_id"},
        "at": {"type": "number", "minimum": 0},
        "pose": {"$ref": "#/$defs/non_empty_string"},
        "readability": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id", "acting_beat_id", "key_pose_id", "timing",
        "intent", "purpose", "provenance"
      ],
      "properties": {
        "hold_id": {"$ref": "#/$defs/hold_id"},
        "acting_beat_id": {"$ref": "#/$defs/acting_beat_id"},
        "key_pose_id": {"$ref": "#/$defs/key_pose_id"},
        "timing": {"$ref": "#/$defs/time_range"},
        "intent": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "applicable_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "intent"],
      "properties": {
        "applicability": {"enum": ["specified", "none", "not-applicable"]},
        "intent": {"$ref": "#/$defs/decision"}
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_intent_id", "performance_intent_id"],
      "properties": {
        "camera_intent_id": {"$ref": "#/$defs/camera_intent_id"},
        "performance_intent_id": {"$ref": "#/$defs/performance_intent_id"}
      }
    },
    "motion_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_realism", "intentional_stylization"],
      "properties": {
        "physical_realism": {"$ref": "#/$defs/decision"},
        "intentional_stylization": {"$ref": "#/$defs/decision"}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_id", "element", "method", "method_confirmation",
        "certainty", "assumption"
      ],
      "properties": {
        "simulation_id": {"$ref": "#/$defs/simulation_id"},
        "element": {"$ref": "#/$defs/non_empty_string"},
        "method": {"$ref": "#/$defs/non_empty_string"},
        "method_confirmation": {"enum": ["confirmed", "unconfirmed"]},
        "certainty": {
          "enum": ["assumption", "uncertainty", "confirmed", "approved"]
        },
        "assumption": {"$ref": "#/$defs/decision"}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_id", "order", "previous_continuity_id",
        "entry_state", "exit_state", "purpose", "provenance"
      ],
      "properties": {
        "continuity_id": {"$ref": "#/$defs/continuity_id"},
        "order": {"type": "integer", "minimum": 1},
        "previous_continuity_id": {
          "oneOf": [
            {"$ref": "#/$defs/continuity_id"},
            {"type": "null"}
          ]
        },
        "entry_state": {"$ref": "#/$defs/non_empty_string"},
        "exit_state": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "shot_character_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animation_plan_id", "scene_id", "shot_id", "character_id",
        "source_bindings", "acting_beats", "key_poses", "staging",
        "timing_intent", "spacing", "arcs", "weight", "anticipation",
        "follow_through_overlap", "holds", "facial_performance", "lip_sync",
        "camera_relationship", "motion_model", "simulations", "continuity",
        "acceptance_criteria"
      ],
      "properties": {
        "animation_plan_id": {"$ref": "#/$defs/animation_plan_id"},
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_id": {"$ref": "#/$defs/non_empty_string"},
        "character_id": {"$ref": "#/$defs/character_id"},
        "source_bindings": {"$ref": "#/$defs/source_bindings"},
        "acting_beats": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/acting_beat"}
        },
        "key_poses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/key_pose"}
        },
        "staging": {"$ref": "#/$defs/decision"},
        "timing_intent": {"$ref": "#/$defs/decision"},
        "spacing": {"$ref": "#/$defs/decision"},
        "arcs": {"$ref": "#/$defs/decision"},
        "weight": {"$ref": "#/$defs/decision"},
        "anticipation": {"$ref": "#/$defs/decision"},
        "follow_through_overlap": {"$ref": "#/$defs/decision"},
        "holds": {
          "type": "array",
          "items": {"$ref": "#/$defs/hold"}
        },
        "facial_performance": {"$ref": "#/$defs/applicable_intent"},
        "lip_sync": {"$ref": "#/$defs/applicable_intent"},
        "camera_relationship": {"$ref": "#/$defs/decision"},
        "motion_model": {"$ref": "#/$defs/motion_model"},
        "simulations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/simulation"}
        },
        "continuity": {"$ref": "#/$defs/continuity"},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/decision"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "source_context",
    "shot_character_plans", "assumptions", "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "source_context": {"$ref": "#/$defs/source_context"},
    "shot_character_plans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot_character_plan"}
    },
    "assumptions": {"$ref": "#/$defs/string_array"},
    "uncertainties": {"$ref": "#/$defs/string_array"}
  }
}
