{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/continuity-plan.schema.json",
  "title": "Continuity Plan",
  "$defs": {
    "continuity_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-CN[0-9]{3,}(?![\\s\\S])"},
    "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-SH[0-9]{3,}(?![\\s\\S])"},
    "non_empty_string": {"type": "string", "minLength": 1}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "assumptions", "continuity_strategy", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"$ref": "#/$defs/non_empty_string"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
    "continuity_strategy": {"$ref": "#/$defs/non_empty_string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "continuity_id",
          "shot_ids",
          "category",
          "tracked_state",
          "required_transition",
          "reset_instruction",
          "severity"
        ],
        "properties": {
          "continuity_id": {"$ref": "#/$defs/continuity_id"},
          "shot_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/shot_id"},
            "uniqueItems": true
          },
          "category": {
            "enum": [
              "axis",
              "eyeline",
              "position",
              "action",
              "prop",
              "wardrobe",
              "makeup",
              "environment",
              "lighting",
              "sound",
              "reset"
            ]
          },
          "tracked_state": {"$ref": "#/$defs/non_empty_string"},
          "required_transition": {"$ref": "#/$defs/non_empty_string"},
          "reset_instruction": {"$ref": "#/$defs/non_empty_string"},
          "severity": {"enum": ["info", "warning", "critical"]}
        }
      }
    }
  }
}
