{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/sound-post-plan.schema.json",
  "title": "Sound Post Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "unit_id", "project_format", "source_context", "items", "assumptions", "uncertainties"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "positive_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "edit_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "source_reference"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/positive_id"},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "measurement_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "category", "metric", "value", "unit", "source_reference"],
      "properties": {
        "measurement_id": {"$ref": "#/$defs/positive_id"},
        "category": {"enum": ["loudness", "peak", "noise", "intelligibility"]},
        "metric": {"enum": ["integrated-loudness", "short-term-loudness", "momentary-loudness", "true-peak", "sample-peak", "noise-floor", "dialogue-intelligibility"]},
        "value": {"type": "number"},
        "unit": {"$ref": "#/$defs/text"},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "numeric_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "category", "metric", "value", "unit", "claim"],
      "properties": {
        "measurement_id": {"$ref": "#/$defs/positive_id"},
        "category": {"enum": ["loudness", "peak", "noise", "intelligibility"]},
        "metric": {"enum": ["integrated-loudness", "short-term-loudness", "momentary-loudness", "true-peak", "sample-peak", "noise-floor", "dialogue-intelligibility"]},
        "value": {"type": "number"},
        "unit": {"$ref": "#/$defs/text"},
        "claim": {"$ref": "#/$defs/text"}
      }
    },
    "inspection_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_kind", "source_reference"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/positive_id"},
        "evidence_kind": {"enum": ["audio", "picture", "metadata", "transcript", "mix-session", "delivery-specification"]},
        "source_reference": {"$ref": "#/$defs/text"}
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "intent"],
      "properties": {
        "mode": {"enum": ["objective", "subjective", "spatial-focus", "dialogue-focus", "accessibility", "not-applicable-from-supplied-material"]},
        "intent": {"$ref": "#/$defs/text"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sound_post_item_id", "responsibility", "edit_segment_ids", "dramatic_purpose", "perspective", "state", "instruction"],
      "properties": {
        "sound_post_item_id": {"$ref": "#/$defs/positive_id"},
        "responsibility": {"enum": ["dialogue-edit", "repair", "adr", "foley", "ambience", "effects", "sound-design", "transition", "intentional-silence", "premix-group", "automation", "mix-priority", "accessibility", "loudness-assumption", "mastering"]},
        "edit_segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/positive_id"}},
        "dramatic_purpose": {"$ref": "#/$defs/text"},
        "perspective": {"$ref": "#/$defs/perspective"},
        "state": {"enum": ["planned", "awaiting-input", "inspected"]},
        "instruction": {"$ref": "#/$defs/text"},
        "numeric_measurements": {"type": "array", "items": {"$ref": "#/$defs/numeric_measurement"}},
        "inspection_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/positive_id"}},
        "delivery_assumption": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"responsibility": {"const": "loudness-assumption"}}},
          "then": {"required": ["delivery_assumption"]}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"$ref": "#/$defs/positive_id"},
    "unit_id": {"$ref": "#/$defs/positive_id"},
    "project_format": {"enum": ["feature", "short", "series", "documentary", "commercial", "music-video", "short-form"]},
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit_plan_reference", "edit_segments", "measurement_evidence", "inspection_evidence"],
      "properties": {
        "edit_plan_reference": {"$ref": "#/$defs/text"},
        "edit_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edit_segment"}},
        "measurement_evidence": {"type": "array", "items": {"$ref": "#/$defs/measurement_evidence"}},
        "inspection_evidence": {"type": "array", "items": {"$ref": "#/$defs/inspection_evidence"}}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  }
}
