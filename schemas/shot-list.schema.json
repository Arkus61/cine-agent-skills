{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/shot-list.schema.json",
  "title": "Shot List",
  "$defs": {
    "beat_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-B[0-9]{2,}(?![\\s\\S])"},
    "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-SH[0-9]{3,}(?![\\s\\S])"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "assumptions", "shots"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "beat_ids", "size", "angle", "lens_mm", "camera_support", "movement", "subject", "action", "composition", "dramatic_purpose", "audio", "continuity"],
        "properties": {
          "shot_id": {"$ref": "#/$defs/shot_id"},
          "beat_ids": {"type": "array", "items": {"$ref": "#/$defs/beat_id"}, "minItems": 1},
          "size": {"type": "string", "enum": ["extreme-wide", "wide", "full", "medium-wide", "medium", "medium-close", "close-up", "extreme-close-up", "insert", "pov", "over-shoulder"]},
          "angle": {"type": "string", "minLength": 1},
          "lens_mm": {"type": "number", "exclusiveMinimum": 0},
          "camera_support": {"type": "string", "minLength": 1},
          "movement": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "composition": {"type": "string", "minLength": 1},
          "dramatic_purpose": {"type": "string", "minLength": 1},
          "audio": {"type": "string", "minLength": 1},
          "continuity": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
