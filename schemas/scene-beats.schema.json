{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/scene-beats.schema.json",
  "title": "Scene Beats",
  "$defs": {
    "beat_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-B[0-9]{2,}(?![\\s\\S])"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "scene_objective", "turn", "assumptions", "beats"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "scene_objective": {"type": "string", "minLength": 1},
    "turn": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beat_id", "evidence", "action", "tactic", "value_shift", "visual_opportunity"],
        "properties": {
          "beat_id": {"$ref": "#/$defs/beat_id"},
          "evidence": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "tactic": {"type": "string", "minLength": 1},
          "value_shift": {"type": "string", "minLength": 1},
          "visual_opportunity": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
