{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/blocking-plan.schema.json",
  "title": "Blocking Plan",
  "$defs": {
    "beat_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-B[0-9]{2,}(?![\\s\\S])"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "space", "axis", "positions", "moves", "continuity_rules", "assumptions"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "space": {"type": "string", "minLength": 1},
    "axis": {"type": "string", "minLength": 1},
    "positions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beat_id", "character", "start", "end", "motivation"],
        "properties": {
          "beat_id": {"$ref": "#/$defs/beat_id"},
          "character": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "motivation": {"type": "string"}
        }
      }
    },
    "continuity_rules": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
