{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/camera-movement-plan.schema.json",
  "title": "Camera Movement Plan",
  "$defs": {
    "beat_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-B[0-9]{2,}(?![\\s\\S])"},
    "movement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-M[0-9]{2,}(?![\\s\\S])"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "movement_philosophy", "moves", "assumptions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "movement_philosophy": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["move_id", "beat_ids", "name_ru", "name_en", "movement", "direction", "speed", "framing", "start", "end", "purpose", "ai_video_prompt"],
        "properties": {
          "move_id": {"$ref": "#/$defs/movement_id"},
          "beat_ids": {"type": "array", "items": {"$ref": "#/$defs/beat_id"}, "minItems": 1},
          "name_ru": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "movement": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1},
          "speed": {"type": "string", "minLength": 1},
          "framing": {"type": "string", "minLength": 1},
          "start": {"type": "string", "minLength": 1},
          "end": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "ai_video_prompt": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
