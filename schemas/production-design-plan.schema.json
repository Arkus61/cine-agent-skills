{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/production-design-plan.schema.json",
  "title": "Production Design Plan",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_refs", "basis"],
      "properties": {
        "status": {
          "enum": ["supplied", "inferred", "proposed", "approved"]
        },
        "source_refs": {"$ref": "#/$defs/non_empty_string_array"},
        "basis": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_ids", "scene_ids", "shot_ids"],
      "properties": {
        "world_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "scene_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "shot_ids": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "visual_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_function",
        "design_strategy",
        "shape_language",
        "material_language",
        "palette",
        "scale",
        "wear",
        "cultural_logic",
        "motifs",
        "purpose",
        "provenance"
      ],
      "properties": {
        "story_function": {"$ref": "#/$defs/non_empty_string"},
        "design_strategy": {"$ref": "#/$defs/non_empty_string"},
        "shape_language": {"$ref": "#/$defs/non_empty_string_array"},
        "material_language": {"$ref": "#/$defs/non_empty_string_array"},
        "palette": {"$ref": "#/$defs/non_empty_string_array"},
        "scale": {"$ref": "#/$defs/non_empty_string"},
        "wear": {"$ref": "#/$defs/non_empty_string"},
        "cultural_logic": {"$ref": "#/$defs/non_empty_string"},
        "motifs": {"$ref": "#/$defs/string_array"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "asset_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "provenance",
        "form",
        "materials",
        "graphics",
        "palette_roles",
        "scale",
        "wear",
        "cultural_logic",
        "motifs"
      ],
      "properties": {
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "form": {"$ref": "#/$defs/non_empty_string"},
        "materials": {"$ref": "#/$defs/string_array"},
        "graphics": {"$ref": "#/$defs/string_array"},
        "palette_roles": {"$ref": "#/$defs/non_empty_string_array"},
        "scale": {"$ref": "#/$defs/non_empty_string"},
        "wear": {"$ref": "#/$defs/non_empty_string"},
        "cultural_logic": {"$ref": "#/$defs/non_empty_string"},
        "motifs": {"$ref": "#/$defs/string_array"}
      }
    },
    "practical_digital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_status", "method", "rationale", "dependencies"],
      "properties": {
        "claim_status": {"const": "assumption"},
        "method": {
          "enum": ["practical", "digital", "hybrid", "undetermined"]
        },
        "rationale": {"$ref": "#/$defs/non_empty_string"},
        "dependencies": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "name",
        "purpose",
        "provenance",
        "world_ids",
        "scene_ids",
        "shot_ids",
        "design",
        "practical_digital"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AS(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
        },
        "asset_type": {
          "enum": ["environment", "set", "prop", "material", "graphic"]
        },
        "name": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "world_ids": {"$ref": "#/$defs/string_array"},
        "scene_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "shot_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "design": {"$ref": "#/$defs/asset_design"},
        "practical_digital": {"$ref": "#/$defs/practical_digital"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "shot_id", "asset_ids", "purpose"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_id": {"$ref": "#/$defs/non_empty_string"},
        "asset_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "purpose": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "continuity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "state_id",
        "scene_id",
        "shot_ids",
        "entry_state",
        "exit_state",
        "reset_to",
        "reset_actions",
        "purpose"
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/non_empty_string"},
        "state_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AS(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})-ST(?:0[1-9]|[1-9][0-9])$"
        },
        "scene_id": {"$ref": "#/$defs/non_empty_string"},
        "shot_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "entry_state": {"$ref": "#/$defs/non_empty_string"},
        "exit_state": {"$ref": "#/$defs/non_empty_string"},
        "reset_to": {"$ref": "#/$defs/non_empty_string"},
        "reset_actions": {"$ref": "#/$defs/non_empty_string_array"},
        "purpose": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "department",
        "asset_ids",
        "scene_ids",
        "shot_ids",
        "need",
        "status",
        "purpose"
      ],
      "properties": {
        "department": {
          "enum": [
            "art",
            "camera",
            "lighting",
            "vfx",
            "special-effects",
            "animation",
            "costume",
            "hair-makeup",
            "sound",
            "stunts",
            "continuity"
          ]
        },
        "asset_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "scene_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "shot_ids": {"$ref": "#/$defs/non_empty_string_array"},
        "need": {"$ref": "#/$defs/non_empty_string"},
        "status": {"enum": ["confirmed", "assumption", "unresolved"]},
        "purpose": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_context",
    "visual_concept",
    "assets",
    "coverage",
    "continuity_states",
    "cross_department_dependencies",
    "assumptions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "source_context": {"$ref": "#/$defs/source_context"},
    "visual_concept": {"$ref": "#/$defs/visual_concept"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "continuity_states": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/continuity_state"}
    },
    "cross_department_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "assumptions": {"$ref": "#/$defs/string_array"},
    "uncertainties": {"$ref": "#/$defs/string_array"}
  }
}
