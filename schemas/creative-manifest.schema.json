{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/creative-manifest.schema.json",
  "title": "v2 Creative Manifest",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
      "not": {
        "anyOf": [
          {"pattern": "\\.\\."},
          {"pattern": "^/"},
          {"pattern": "^[A-Za-z]:"}
        ]
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "profile",
    "project_id",
    "project_format",
    "production_modes",
    "units",
    "layers",
    "validation_status",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "release_version": {"const": "2.0.0"},
    "profile": {"const": "full-creative-v2"},
    "project_id": {"$ref": "#/$defs/non_empty_string"},
    "project_format": {
      "enum": [
        "feature",
        "short",
        "series",
        "documentary",
        "commercial",
        "music-video",
        "short-form"
      ]
    },
    "production_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["live-action", "animation", "ai", "hybrid"]
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "production", "post"],
      "properties": {
        "story": {"$ref": "#/$defs/relative_path"},
        "production": {"$ref": "#/$defs/relative_path"},
        "post": {"$ref": "#/$defs/relative_path"}
      }
    },
    "validation_status": {"const": "valid"},
    "unresolved_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    }
  }
}
