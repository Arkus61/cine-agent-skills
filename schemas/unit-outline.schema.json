{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/unit-outline.schema.json",
  "title": "Unit Outline",
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "non_empty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-EV(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "plotline_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-PL(?:0[1-9]|[1-9][0-9])$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:E|U)(?:0[1-9]|[1-9][0-9])-SC(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event_id"},
      "uniqueItems": true
    },
    "plotline_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/plotline_id"},
      "uniqueItems": true
    },
    "scene_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene_id"},
      "uniqueItems": true
    },
    "scene_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "function"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "function": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id", "scene_index", "start_seconds", "end_seconds", "title",
        "summary", "story_function", "event_ids", "plotline_ids",
        "evidence_status", "retention_function"
      ],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "scene_index": {"type": "integer", "minimum": 1, "maximum": 999},
        "start_seconds": {"type": "integer", "minimum": 0},
        "end_seconds": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/non_empty_string"},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "story_function": {"$ref": "#/$defs/non_empty_string"},
        "event_ids": {"$ref": "#/$defs/event_ids"},
        "plotline_ids": {"$ref": "#/$defs/plotline_ids"},
        "evidence_status": {"enum": ["planned", "discovered", "not-applicable"]},
        "retention_function": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "event_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "scene_ids", "outcome"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "scene_ids": {"$ref": "#/$defs/scene_ids"},
        "outcome": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "plotline_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plotline_id", "scene_ids", "advancement"],
      "properties": {
        "plotline_id": {"$ref": "#/$defs/plotline_id"},
        "scene_ids": {"$ref": "#/$defs/scene_ids"},
        "advancement": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "emotional_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "from_state", "to_state", "change"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "from_state": {"$ref": "#/$defs/non_empty_string"},
        "to_state": {"$ref": "#/$defs/non_empty_string"},
        "change": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "act_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "turn", "changed_pressure"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "turn": {"$ref": "#/$defs/non_empty_string"},
        "changed_pressure": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "outcome", "unit_change"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "outcome": {"$ref": "#/$defs/non_empty_string"},
        "unit_change": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "forward_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "promise", "dependency"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "promise": {"$ref": "#/$defs/non_empty_string"},
        "dependency": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "season_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "carry_forward"],
      "properties": {
        "dependency": {"$ref": "#/$defs/non_empty_string"},
        "carry_forward": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "series_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "episode_position", "local_resolution", "season_dependencies"],
      "properties": {
        "mode": {"const": "series-episode"},
        "episode_position": {"enum": ["nonfinal", "finale"]},
        "local_resolution": {"$ref": "#/$defs/non_empty_string"},
        "season_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/season_dependency"},
          "uniqueItems": true
        }
      }
    },
    "whole_script_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "whole_script_complete", "closure"],
      "properties": {
        "mode": {"const": "whole-script"},
        "whole_script_complete": {"const": true},
        "closure": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "status", "basis", "contingency"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "status": {"enum": ["planned", "discovered"]},
        "basis": {"$ref": "#/$defs/non_empty_string"},
        "contingency": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "documentary_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "evidence_items", "unknown_outcomes"],
      "properties": {
        "mode": {"const": "documentary-evidence"},
        "evidence_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_item"},
          "uniqueItems": true
        },
        "unknown_outcomes": {"$ref": "#/$defs/non_empty_string_list"}
      }
    },
    "runtime_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "orientation_by_seconds", "payoff_by_seconds", "orientation",
        "payoff", "retention_strategy"
      ],
      "properties": {
        "mode": {"const": "runtime-led"},
        "orientation_by_seconds": {"type": "integer", "minimum": 1},
        "payoff_by_seconds": {"type": "integer", "minimum": 1},
        "orientation": {"$ref": "#/$defs/non_empty_string"},
        "payoff": {"$ref": "#/$defs/non_empty_string"},
        "retention_strategy": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "project_format", "unit_id", "runtime_seconds",
    "runtime_basis", "unit_objective", "structural_model", "source_event_ids",
    "source_plotline_ids", "opening_hook", "scenes", "event_coverage",
    "plotline_coverage", "emotional_turns", "act_outs", "midpoint", "climax",
    "resolution", "forward_hook", "format_plan", "assumptions", "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"$ref": "#/$defs/non_empty_string"},
    "project_format": {
      "enum": ["feature", "short", "series", "documentary", "commercial", "music-video", "short-form"]
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-(?:E|U)(?:0[1-9]|[1-9][0-9])$"
    },
    "runtime_seconds": {"type": "integer", "minimum": 1},
    "runtime_basis": {"$ref": "#/$defs/non_empty_string"},
    "unit_objective": {"$ref": "#/$defs/non_empty_string"},
    "structural_model": {"$ref": "#/$defs/non_empty_string"},
    "source_event_ids": {"$ref": "#/$defs/event_ids"},
    "source_plotline_ids": {"$ref": "#/$defs/plotline_ids"},
    "opening_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "promise", "function"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/scene_id"},
        "promise": {"$ref": "#/$defs/non_empty_string"},
        "function": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {"$ref": "#/$defs/scene"}
    },
    "event_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event_coverage"}
    },
    "plotline_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/plotline_coverage"}
    },
    "emotional_turns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/emotional_turn"}
    },
    "act_outs": {
      "type": "array",
      "items": {"$ref": "#/$defs/act_out"},
      "uniqueItems": true
    },
    "midpoint": {
      "oneOf": [{"$ref": "#/$defs/scene_reference"}, {"type": "null"}]
    },
    "climax": {
      "oneOf": [{"$ref": "#/$defs/scene_reference"}, {"type": "null"}]
    },
    "resolution": {"$ref": "#/$defs/resolution"},
    "forward_hook": {
      "oneOf": [{"$ref": "#/$defs/forward_hook"}, {"type": "null"}]
    },
    "format_plan": {
      "oneOf": [
        {"$ref": "#/$defs/series_plan"},
        {"$ref": "#/$defs/whole_script_plan"},
        {"$ref": "#/$defs/documentary_plan"},
        {"$ref": "#/$defs/runtime_plan"}
      ]
    },
    "assumptions": {"$ref": "#/$defs/string_list"},
    "uncertainties": {"$ref": "#/$defs/string_list"}
  },
  "allOf": [
    {
      "if": {"properties": {"project_format": {"const": "series"}}},
      "then": {
        "properties": {
          "unit_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-E(?:0[1-9]|[1-9][0-9])$"},
          "format_plan": {"$ref": "#/$defs/series_plan"}
        }
      }
    },
    {
      "if": {"properties": {"project_format": {"enum": ["feature", "short"]}}},
      "then": {
        "properties": {
          "unit_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-U(?:0[1-9]|[1-9][0-9])$"},
          "format_plan": {"$ref": "#/$defs/whole_script_plan"}
        }
      }
    },
    {
      "if": {"properties": {"project_format": {"const": "documentary"}}},
      "then": {
        "properties": {
          "unit_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-U(?:0[1-9]|[1-9][0-9])$"},
          "format_plan": {"$ref": "#/$defs/documentary_plan"},
          "scenes": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/scene"},
                {"properties": {"evidence_status": {"enum": ["planned", "discovered"]}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"project_format": {"enum": ["commercial", "music-video", "short-form"]}}},
      "then": {
        "properties": {
          "unit_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-U(?:0[1-9]|[1-9][0-9])$"},
          "format_plan": {"$ref": "#/$defs/runtime_plan"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "format_plan": {
            "properties": {"mode": {"const": "series-episode"}, "episode_position": {"const": "nonfinal"}},
            "required": ["mode", "episode_position"]
          }
        }
      },
      "then": {"properties": {"forward_hook": {"$ref": "#/$defs/forward_hook"}}}
    }
  ]
}
