{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/media-review-report.schema.json",
  "title": "Evidence-based media review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "package_status", "source_context", "missing_inputs", "blockers", "items"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "reference": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["character", "scene", "shot", "asset", "world", "beat", "sound"]}, "id": {"$ref": "#/$defs/text"}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "statement", "source_reference", "dimension", "required_evidence"], "properties": {"criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-AC(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"}, "statement": {"$ref": "#/$defs/text"}, "source_reference": {"$ref": "#/$defs/text"}, "dimension": {"enum": ["composition", "performance", "identity", "action", "movement", "light", "continuity", "sound", "artifacts", "acceptance"]}, "required_evidence": {"enum": ["static-visible", "motion", "audio", "measurable-metadata"]}}},
    "prompt_package": {"type": "object", "additionalProperties": false, "required": ["prompt_id", "upstream_references", "acceptance_criteria"], "properties": {"prompt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-MP(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"}, "upstream_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/criterion"}}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["input_id", "modality", "identity", "fingerprint"], "properties": {"input_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-IN(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"}, "modality": {"enum": ["still", "motion", "audio", "audiovisual", "metadata"]}, "identity": {"$ref": "#/$defs/text"}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "input_id", "criterion_id", "kind", "observation"], "properties": {"evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-ME(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"}, "input_id": {"$ref": "#/$defs/text"}, "criterion_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["direct-inspection", "measurable-metadata"]}, "observation": {"$ref": "#/$defs/text"}, "measurement": {"$ref": "#/$defs/text"}}, "allOf": [{"if": {"properties": {"kind": {"const": "measurable-metadata"}}}, "then": {"required": ["measurement"]}}]},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "outcome", "evidence_ids"], "properties": {"criterion_id": {"$ref": "#/$defs/text"}, "outcome": {"enum": ["pass", "fail", "not-assessable"]}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}, "allOf": [{"if": {"properties": {"outcome": {"enum": ["pass", "fail"]}}}, "then": {"properties": {"evidence_ids": {"minItems": 1}}}}]},
    "deviation": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "severity", "detail", "resolved"], "properties": {"criterion_id": {"$ref": "#/$defs/text"}, "severity": {"enum": ["localized", "foundational", "subjective", "rights", "safety"]}, "detail": {"$ref": "#/$defs/text"}, "resolved": {"type": "boolean"}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["reason", "question"], "properties": {"reason": {"enum": ["subjective", "rights", "safety"]}, "question": {"$ref": "#/$defs/text"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["media_id", "status", "prompt_id", "upstream_references", "inspected_input", "inspection_evidence", "criterion_outcomes", "deviations", "repair_scope", "reviewer_uncertainty"], "properties": {"media_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*-MD(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"}, "status": {"enum": ["approved", "repair", "regenerate", "human-review"]}, "prompt_id": {"$ref": "#/$defs/text"}, "upstream_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "inspected_input": {"$ref": "#/$defs/input"}, "inspection_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "criterion_outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outcome"}}, "deviations": {"type": "array", "items": {"$ref": "#/$defs/deviation"}}, "repair_scope": {"enum": ["none", "localized", "foundational", "human-handoff"]}, "reviewer_uncertainty": {"$ref": "#/$defs/text"}, "human_review_handoff": {"$ref": "#/$defs/handoff"}}},
    "missing_input": {"type": "object", "additionalProperties": false, "required": ["kind", "detail"], "properties": {"kind": {"enum": ["media", "metadata", "criterion"]}, "detail": {"$ref": "#/$defs/text"}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["kind", "detail"], "properties": {"kind": {"enum": ["evidence", "subjective", "rights", "safety"]}, "detail": {"$ref": "#/$defs/text"}}}
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "package_status": {"enum": ["awaiting-media", "reviewed", "blocked"]},
    "source_context": {"type": "object", "additionalProperties": false, "required": ["registries", "prompt_packages"], "properties": {"registries": {"type": "object", "additionalProperties": false, "required": ["scene_ids", "shot_ids", "asset_ids"], "properties": {"character_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "scene_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "shot_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "asset_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "world_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "beat_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "sound_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}, "prompt_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/prompt_package"}}}},
    "missing_inputs": {"type": "array", "items": {"$ref": "#/$defs/missing_input"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "allOf": [
    {"if": {"properties": {"package_status": {"const": "awaiting-media"}}}, "then": {"properties": {"items": {"maxItems": 0}, "missing_inputs": {"minItems": 1}, "blockers": {"maxItems": 0}}}},
    {"if": {"properties": {"package_status": {"const": "reviewed"}}}, "then": {"properties": {"items": {"minItems": 1}}}},
    {"if": {"properties": {"package_status": {"const": "blocked"}}}, "then": {"properties": {"blockers": {"minItems": 1}}}}
  ]
}
