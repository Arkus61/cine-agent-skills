{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/music-plan.schema.json",
  "title": "Evidence-aware music story plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "unit_id",
    "project_format",
    "source_context",
    "spotting",
    "cues",
    "assumptions",
    "uncertainties"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "source_reference"
      ],
      "properties": {
        "segment_id": {
          "$ref": "#/$defs/id"
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_id",
        "source_reference"
      ],
      "properties": {
        "character_id": {
          "$ref": "#/$defs/id"
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "source_reference"
      ],
      "properties": {
        "theme_id": {
          "$ref": "#/$defs/id"
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue_id",
        "edit_segment_id",
        "source_reference"
      ],
      "properties": {
        "dialogue_id": {
          "$ref": "#/$defs/id"
        },
        "edit_segment_id": {
          "$ref": "#/$defs/id"
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_evidence_id",
        "edit_segment_ids",
        "exact_start_timecode",
        "exact_end_timecode",
        "lock_status",
        "source_reference"
      ],
      "properties": {
        "duration_evidence_id": {
          "$ref": "#/$defs/id"
        },
        "edit_segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "exact_start_timecode": {
          "$ref": "#/$defs/text"
        },
        "exact_end_timecode": {
          "$ref": "#/$defs/text"
        },
        "lock_status": {
          "const": "picture-locked"
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim_type",
        "cue_ids",
        "source_reference"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "claim_type": {
          "enum": [
            "composed",
            "recorded",
            "reviewed",
            "approved",
            "licensed",
            "cleared",
            "locked",
            "delivered"
          ]
        },
        "cue_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_reference": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spotting_id",
        "edit_segment_id",
        "decision",
        "narrative_purpose"
      ],
      "properties": {
        "spotting_id": {
          "$ref": "#/$defs/id"
        },
        "edit_segment_id": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "enum": [
            "scored",
            "unscored"
          ]
        },
        "narrative_purpose": {
          "$ref": "#/$defs/text"
        },
        "cue_id": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "scored"
              }
            }
          },
          "then": {
            "required": [
              "cue_id"
            ]
          }
        }
      ]
    },
    "dialogue_interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue_id",
        "priority",
        "approach"
      ],
      "properties": {
        "dialogue_id": {
          "$ref": "#/$defs/id"
        },
        "priority": {
          "enum": [
            "dialogue",
            "music",
            "shared"
          ]
        },
        "approach": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "edit_segment_ids",
        "thematic_role",
        "leitmotif_bindings",
        "entry_exit_logic",
        "energy_curve",
        "instrumentation_intent",
        "diegetic_status",
        "transition",
        "silence_alternative",
        "source_assumption",
        "state",
        "approval_boundary"
      ],
      "properties": {
        "cue_id": {
          "$ref": "#/$defs/id"
        },
        "edit_segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "thematic_role": {
          "$ref": "#/$defs/text"
        },
        "leitmotif_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding_type",
              "binding_id",
              "transformation"
            ],
            "properties": {
              "binding_type": {
                "enum": [
                  "character",
                  "theme"
                ]
              },
              "binding_id": {
                "$ref": "#/$defs/id"
              },
              "transformation": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "entry_exit_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "exit"
          ],
          "properties": {
            "entry": {
              "$ref": "#/$defs/text"
            },
            "exit": {
              "$ref": "#/$defs/text"
            },
            "exact_start_timecode": {
              "$ref": "#/$defs/text"
            },
            "exact_end_timecode": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "energy_curve": {
          "$ref": "#/$defs/text"
        },
        "instrumentation_intent": {
          "$ref": "#/$defs/text"
        },
        "diegetic_status": {
          "enum": [
            "diegetic",
            "nondiegetic",
            "source-assumption"
          ]
        },
        "dialogue_interaction": {
          "$ref": "#/$defs/dialogue_interaction"
        },
        "dialogue_interactions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dialogue_interaction"
          }
        },
        "transition": {
          "$ref": "#/$defs/text"
        },
        "silence_alternative": {
          "$ref": "#/$defs/text"
        },
        "source_assumption": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "enum": [
            "planned",
            "awaiting-input",
            "proposed",
            "composed",
            "recorded",
            "reviewed",
            "approved",
            "licensed",
            "cleared",
            "locked",
            "delivered"
          ]
        },
        "approval_boundary": {
          "$ref": "#/$defs/text"
        },
        "locked_duration_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "review_rights_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_plan_reference",
        "edit_segments",
        "characters",
        "themes",
        "protected_dialogue",
        "locked_duration_evidence",
        "review_rights_evidence"
      ],
      "properties": {
        "edit_plan_reference": {
          "$ref": "#/$defs/text"
        },
        "edit_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/character"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theme"
          }
        },
        "protected_dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          }
        },
        "locked_duration_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duration"
          }
        },
        "review_rights_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "unit_id": {
      "$ref": "#/$defs/id"
    },
    "project_format": {
      "enum": [
        "feature",
        "short",
        "series",
        "documentary",
        "commercial",
        "music-video",
        "short-form"
      ]
    },
    "source_context": {
      "$ref": "#/$defs/context"
    },
    "spotting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spot"
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  }
}
