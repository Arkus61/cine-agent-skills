{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/layer-manifest.schema.json",
  "title": "v2 Layer Manifest",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
      "not": {
        "anyOf": [
          {"pattern": "\\.\\."},
          {"pattern": "^/"},
          {"pattern": "^[A-Za-z]:"}
        ]
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "project_id",
    "layer",
    "profile",
    "artifacts",
    "validation_status",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "release_version": {"const": "2.0.0"},
    "project_id": {"$ref": "#/$defs/non_empty_string"},
    "layer": {
      "enum": ["story", "script", "production", "post"]
    },
    "profile": {
      "enum": [
        "story-v2",
        "production-v2",
        "post-v2",
        "full-creative-v2"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "schema_name",
          "schema_version",
          "dependency_order"
        ],
        "properties": {
          "filename": {"$ref": "#/$defs/relative_path"},
          "schema_name": {"$ref": "#/$defs/non_empty_string"},
          "schema_version": {"const": "2.0"},
          "dependency_order": {"type": "integer", "minimum": 1}
        }
      }
    },
    "validation_status": {"const": "valid"},
    "unresolved_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    }
  }
}
