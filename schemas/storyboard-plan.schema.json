{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cine-agent-skills/storyboard-plan.schema.json",
  "title": "Storyboard Plan",
  "$defs": {
    "panel_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-SB[0-9]{3,}(?![\\s\\S])"},
    "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-SH[0-9]{3,}(?![\\s\\S])"},
    "non_empty_string": {"type": "string", "minLength": 1}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "assumptions", "storyboard_intent", "panels"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "scene_id": {"$ref": "#/$defs/non_empty_string"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
    "storyboard_intent": {"$ref": "#/$defs/non_empty_string"},
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel_id",
          "shot_id",
          "moment",
          "framing",
          "camera_height",
          "angle",
          "foreground",
          "midground",
          "background",
          "subject_placement",
          "action_direction",
          "movement_state",
          "lighting_note",
          "audio_cue",
          "continuity_note",
          "dramatic_purpose"
        ],
        "properties": {
          "panel_id": {"$ref": "#/$defs/panel_id"},
          "shot_id": {"$ref": "#/$defs/shot_id"},
          "moment": {"$ref": "#/$defs/non_empty_string"},
          "framing": {"$ref": "#/$defs/non_empty_string"},
          "camera_height": {"$ref": "#/$defs/non_empty_string"},
          "angle": {"$ref": "#/$defs/non_empty_string"},
          "foreground": {"$ref": "#/$defs/non_empty_string"},
          "midground": {"$ref": "#/$defs/non_empty_string"},
          "background": {"$ref": "#/$defs/non_empty_string"},
          "subject_placement": {"$ref": "#/$defs/non_empty_string"},
          "action_direction": {"$ref": "#/$defs/non_empty_string"},
          "movement_state": {"$ref": "#/$defs/non_empty_string"},
          "lighting_note": {"$ref": "#/$defs/non_empty_string"},
          "audio_cue": {"$ref": "#/$defs/non_empty_string"},
          "continuity_note": {"$ref": "#/$defs/non_empty_string"},
          "dramatic_purpose": {"$ref": "#/$defs/non_empty_string"}
        }
      }
    }
  }
}
