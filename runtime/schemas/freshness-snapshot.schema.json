{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cine-agent-skills.local/runtime/freshness-snapshot.schema.json",
  "type": "object",
  "required": ["snapshot_version", "nodes", "coverage"],
  "additionalProperties": false,
  "properties": {
    "snapshot_version": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "object", "required": ["recorded", "unrecorded"], "additionalProperties": false, "properties": {"recorded": {"type": "array", "items": {"type": "string"}}, "unrecorded": {"type": "array", "items": {"type": "string"}}}}
  }
}
